{
  "name": "desklink-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "api": "cd ../api && exec .venv/bin/python3 app.py",
    "dev:all": "node dev.js",
    "start": "node dev.js",
    "dev:concurrently": "concurrently -k -s first -n \"api,ui\" -c \"cyan,magenta\" \"cd ../api && exec .venv/bin/python3 app.py\" \"exec vite --host\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  }
}
